        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml MyRation_UseCase_Diagram\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\n\nactor \&quot;District Admin\&quot; as Admin\nactor \&quot;Shopkeeper / FPS\&quot; as Shop\nactor \&quot;Beneficiary / Citizen\&quot; as User\n\nrectangle \&quot;Smart Ration Management System\&quot; {\n\n  package \&quot;Auth &amp; Registration\&quot; {\n    usecase \&quot;Login\&quot; as UC_Login\n    usecase \&quot;Register as Beneficiary\&quot; as UC_RegUser\n    usecase \&quot;Register as Shopkeeper\&quot; as UC_RegShop\n    usecase \&quot;Review Pending Registrations\&quot; as UC_Review\n    usecase \&quot;Approve/Reject Beneficiary\&quot; as UC_ApproveUser\n    usecase \&quot;Approve/Reject Shopkeeper\&quot; as UC_ApproveShop\n  }\n\n  package \&quot;Beneficiary Services\&quot; {\n    usecase \&quot;View Profile\&quot; as UC_Profile\n    usecase \&quot;View Monthly Quota\&quot; as UC_Quota\n    usecase \&quot;View Distribution History\&quot; as UC_History\n    usecase \&quot;View Alerts\&quot; as UC_Alerts\n    usecase \&quot;Book Collection Slot\&quot; as UC_BookSlot\n  }\n\n  package \&quot;Shopkeeper Services\&quot; {\n    usecase \&quot;View Shop Stock\&quot; as UC_ViewStock\n    usecase \&quot;Receive &amp; Verify Shipment\&quot; as UC_VerifyShipment\n    usecase \&quot;Verify Beneficiary Locally\&quot; as UC_VerifyUser\n    usecase \&quot;Respond to Warning Alert\&quot; as UC_RespondWarning\n  }\n\n  package \&quot;Distribution\&quot; {\n    usecase \&quot;Collect Ration\&quot; as UC_Collect\n    usecase \&quot;Validate Quota &amp; Stock\&quot; as UC_Validate\n  }\n\n  package \&quot;Admin &amp; Supply\&quot; {\n    usecase \&quot;View Dashboard\&quot; as UC_Dashboard\n    usecase \&quot;Manage Quota\&quot; as UC_ManageQuota\n    usecase \&quot;Add New Ration Item\&quot; as UC_AddItem\n    usecase \&quot;Trigger Supply Allocation\&quot; as UC_Allocate\n  }\n\n  package \&quot;Complaints\&quot; {\n    usecase \&quot;File Complaint\&quot; as UC_FileComplaint\n    usecase \&quot;Manage Complaints\&quot; as UC_ManageComplaints\n  }\n}\n\n&#39; ---- Actor associations ----\nAdmin --&gt; UC_Login\nAdmin --&gt; UC_Dashboard\nAdmin --&gt; UC_Review\nAdmin --&gt; UC_ManageQuota\nAdmin --&gt; UC_AddItem\nAdmin --&gt; UC_Allocate\nAdmin --&gt; UC_ManageComplaints\n\nShop --&gt; UC_Login\nShop --&gt; UC_RegShop\nShop --&gt; UC_ViewStock\nShop --&gt; UC_VerifyShipment\nShop --&gt; UC_VerifyUser\nShop --&gt; UC_RespondWarning\nShop --&gt; UC_Collect\n\nUser --&gt; UC_Login\nUser --&gt; UC_RegUser\nUser --&gt; UC_Profile\nUser --&gt; UC_Quota\nUser --&gt; UC_History\nUser --&gt; UC_Alerts\nUser --&gt; UC_BookSlot\nUser --&gt; UC_FileComplaint\nUser --&gt; UC_Collect\n\n&#39; ---- Include relationships ----\nUC_Profile ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_Quota ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_History ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_Alerts ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_BookSlot ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_FileComplaint ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_ViewStock ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_VerifyShipment ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_Dashboard ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_ManageQuota ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_Collect ..&gt; UC_Validate : &lt;&lt;include&gt;&gt;\n\n&#39; ---- Extend relationships ----\nUC_ApproveUser .up.&gt; UC_Review : &lt;&lt;extend&gt;&gt;\nUC_ApproveShop .up.&gt; UC_Review : &lt;&lt;extend&gt;&gt;\nUC_ManageComplaints .up.&gt; UC_FileComplaint : &lt;&lt;extend&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_a5LcqMx3fO-Jszq4Sl_-1">

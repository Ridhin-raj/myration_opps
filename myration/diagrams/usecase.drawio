  <diagram id="qzmCWSUCTRHPeRtSPreG" name="Page-3">
    <mxGraphModel dx="1330" dy="488" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml MyRation_ClassDiagram\n\nabstract class User {\n  +int id\n  +String username\n  -String password\n  +String name\n  +String mobile\n  +String aadhaar\n  +String status\n  +login(username, password): boolean\n  +register(): void\n  +viewProfile(): Profile\n}\n\nclass Admin {\n  +approveRegistration(userId): void\n  +manageQuota(cardType, item): void\n  +addItem(item): void\n  +resolveComplaint(id): void\n  +viewDashboard(): Stats\n}\n\nclass Shopkeeper {\n  +updateStock(item, qty): void\n  +distributeRation(userId, item, qty): void\n  +verifyShipment(stockId): void\n  +verifyBeneficiary(userId): void\n}\n\nclass Beneficiary {\n  +viewQuota(): Quota\n  +viewHistory(): List&lt;QuotaHistory&gt;\n  +fileComplaint(shopId, msg): void\n  +bookSlot(shopId, date): void\n  +viewAlerts(): List&lt;Alert&gt;\n}\n\nclass UserProfile {\n  +Date dob\n  +String gender\n  +String rationCardNo\n  +String cardType\n  +int familyMembers\n  +boolean verifiedByShopkeeper\n  +boolean verifiedByAdmin\n}\n\nclass Shop {\n  +int id\n  +String shopName\n  +String licenseNo\n  +int capacity\n  +String location\n  +boolean isOpen\n  +String status\n}\n\nclass Stock {\n  +int id\n  +String itemName\n  +decimal allocatedQty\n  +decimal distributedQty\n  +String unit\n  +String monthYear\n}\n\nclass AssignedStock {\n  +int id\n  +String itemName\n  +decimal quantity\n  +String status\n  +String monthYear\n}\n\nclass Quota {\n  +int id\n  +String cardType\n  +String itemName\n  +decimal quantity\n  +decimal price\n}\n\nclass UserBalance {\n  +int id\n  +String itemName\n  +decimal totalQuota\n  +decimal remainingQuota\n  +String monthYear\n}\n\nclass QuotaHistory {\n  +int id\n  +String actionType\n  +decimal amount\n  +Timestamp time\n}\n\nclass StockHistory {\n  +int id\n  +String actionType\n  +decimal quantity\n  +Timestamp time\n}\n\nclass Complaint {\n  +int id\n  +String complaintType\n  +String message\n  +String status\n  +resolve(response): void\n}\n\nclass Alert {\n  +int id\n  +String message\n  +String alertType\n  +boolean isRead\n}\n\nUser &lt;|-- Admin\nUser &lt;|-- Shopkeeper\nUser &lt;|-- Beneficiary\n\nBeneficiary \&quot;1\&quot; *-- \&quot;1\&quot; UserProfile : has\nShopkeeper \&quot;1\&quot; *-- \&quot;1\&quot; Shop : owns\nShop \&quot;1\&quot; o-- \&quot;*\&quot; Stock : maintains\nShop \&quot;1\&quot; o-- \&quot;*\&quot; AssignedStock : receives\nShop \&quot;1\&quot; o-- \&quot;*\&quot; UserProfile : serves\nUser \&quot;1\&quot; o-- \&quot;*\&quot; UserBalance : holds\nUser \&quot;1\&quot; o-- \&quot;*\&quot; QuotaHistory : records\nShop \&quot;1\&quot; o-- \&quot;*\&quot; StockHistory : logs\nUser \&quot;1\&quot; o-- \&quot;*\&quot; Complaint : files\nShop \&quot;1\&quot; o-- \&quot;*\&quot; Complaint : target\nUser \&quot;1\&quot; o-- \&quot;*\&quot; Alert : receives\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zxgmZMwpN7_7I5oSxEKD-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
